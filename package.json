{
  "name": "AI-customer-operation-Cloud",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:postgres": "node apps/api/scripts/test-postgres.ts",
    "test:load": "k6 run apps/api/tests/k6/organization-read.k6.js",
    "test:load:matrix": "node apps/api/scripts/run-k6-matrix.ts",
    "test:load:v1": "k6 run apps/api/tests/k6/version1-mixed.k6.js"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.6.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "1.0.0"
}
