{
  "name": "AI-customer-operation-Cloud",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:postgres": "node apps/api/scripts/test-postgres.ts"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "\u003e=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.6.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
