generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Document {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  title          String
  content        String
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  upload         DocumentUpload?

  @@index([organizationId], map: "documents_organization_idx")
  @@map("documents")
}

model DocumentUpload {
  documentId String   @id @map("document_id") @db.Uuid
  fileName   String   @map("file_name")
  mediaType  String   @map("media_type")
  byteLength Int      @map("byte_length")
  fileData   Bytes    @map("file_data")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("document_uploads")
}
