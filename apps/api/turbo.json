{
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "passThroughEnv": [
        "DATABASE_URL",
        "JWT_SECRET",
        "PORT",
        "DB_POOL_*",
        "ORGANIZATIONS_DATABASE_URL",
        "SERVICE_ROLE",
        "RATE_LIMIT_*"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "TEST_REDIS_URL"
      ]
    },
    "check-types": {
      "dependsOn": [
        "build"
      ]
    }
  }
}
