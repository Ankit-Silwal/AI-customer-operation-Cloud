NODE_ENV=development
AI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_URL=http://localhost:4102
RAG_PORT=4102
# Embeddings run locally in Docker. Only Gemini text generation needs an API key.
PORT=3001
POSTGRES_USER=customer_ops
POSTGRES_PASSWORD=customer_ops_local
POSTGRES_DB=customer_ops
POSTGRES_PORT=5432
DATABASE_URL=postgresql://customer_ops:customer_ops_local@localhost:5432/customer_ops
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=3000
DB_POOL_QUERY_TIMEOUT_MS=5000

# Docker Compose supplies the internal Redis URL automatically. This URL is for
# host development with compose.dev.yaml. Use strong URL-safe deployed passwords.
REDIS_PASSWORD=rate_limits_local
RATE_LIMIT_REDIS_URL=redis://:rate_limits_local@127.0.0.1:6379
RATE_LIMIT_NAMESPACE=customer-ops
RAG_MAX_CONCURRENCY=2

# Browser interfaces. Match origins to public URLs when changing host ports.
WEB_PORT=3030
WEB_ORIGIN=http://localhost:3030
DEMO_PORT=3035
DEMO_ORIGIN=http://localhost:3035
WEB_COOKIE_SECURE=false
# The external company demo reads its key from apps/company-demo/.env.
DOCS_PORT=3040
DOCS_ORIGIN=http://localhost:3040
# Keep a stable dedicated password if rotating JWT_SECRET.
DOCS_DEMO_EMAIL=sandbox@hearth.example
DOCS_DEMO_PASSWORD=
# Nodemailer SMTP; provide real settings to enable email OTPs and recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# Optional complete policy overrides as JSON:
# RATE_LIMIT_POLICY_OVERRIDES={"rag_query":{"limit":5,"seconds":60}}

# Scaling: copies of gateway/core/conversations/documents behind the nginx load balancer.
BACKEND_REPLICAS=3
# nginx proves forwarded client addresses with this shared secret (>= 32 chars; change when deployed).
EDGE_PROXY_SECRET=local-edge-proxy-secret-change-me-0000
# Streaming-replication role used by the two read replicas (URL-safe).
REPLICATION_PASSWORD=replication_local
# Must cover every pool: primary ~= replicas x (core 2 + conversations 1 + documents 1) x DB_POOL_MAX.
POSTGRES_MAX_CONNECTIONS=200

# Separate databases for the new microservices stack (use URL-safe passwords).
IDENTITY_DB_PASSWORD=identity_local
ORGANIZATIONS_DB_PASSWORD=organizations_local
CONVERSATIONS_DB_PASSWORD=conversations_local
DOCUMENTS_DB_PASSWORD=documents_local
# Add your Gemini key later; lowercase api_key is also supported.
api_key=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
QDRANT_PORT=6335
# Inside Docker use the service hostname. To reuse an external server, override QDRANT_URL.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=learning_rag
QDRANT_CREATE_COLLECTION=true

# Host domain servers validate browser sessions against the core through the gateway.
# Compose supplies its own internal core URL.
AUTH_SESSION_URL=http://localhost:3001/auth/session
